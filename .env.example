# ============================================================
# Fenix Backend Environment Variables (copy to .env)
# ============================================================
# In production (NODE_ENV=production) the app enforces hard guards at boot:
#   - JWT secrets must not be placeholders and must differ from each other
#   - CORS_ORIGINS must be real https origins (no localhost)
#   - APP_PUBLIC_URL must use https
#   - BCRYPT_SALT_ROUNDS must be >= 12
#   - credentials must be present for any non-console driver
# A misconfiguration fails fast with a readable error instead of at runtime.
# ------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Number of proxy hops to trust (1 behind a single LB/Nginx). Affects req.ip
# and Secure cookie detection behind TLS terminators.
TRUST_PROXY=1
# Max time (ms) to wait for in-flight requests/dependencies during shutdown.
SHUTDOWN_TIMEOUT_MS=10000

# --- Database ---
DATABASE_URL="postgresql://sms:sms_password@127.0.0.1:5432/sms_dev?schema=public"

# --- Redis (refresh-token blacklist, rate-limit store, BullMQ queue) ---
REDIS_URL="redis://127.0.0.1:6379"

# --- JWT (generate with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7

# --- Password hashing (>=12 in production) ---
BCRYPT_SALT_ROUNDS=12

# --- CORS (comma separated; real https origins in prod) ---
CORS_ORIGINS="http://localhost:5173"

# --- Rate limiting ---
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MIN=15
GLOBAL_RATE_LIMIT_MAX=300
GLOBAL_RATE_LIMIT_WINDOW_MIN=15

# --- Storage adapter: "local" (filesystem) or "s3" (AWS S3 / Cloudflare R2) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-local
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/files
# Required when STORAGE_DRIVER=s3:
S3_REGION=auto
S3_BUCKET=
# For Cloudflare R2 / MinIO set the S3-compatible endpoint (omit for AWS S3):
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL files are served from (CDN or bucket public URL):
S3_PUBLIC_BASE_URL=
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_MIME="image/jpeg,image/png,image/webp,application/pdf"

# --- Email adapter: "console" (logs) | "resend" | "sendgrid" ---
EMAIL_DRIVER=console
EMAIL_FROM="Fenix <no-reply@yourschool.edu>"
RESEND_API_KEY=
SENDGRID_API_KEY=

# --- SMS adapter: "console" (logs) | "twilio" | "africastalking" ---
SMS_DRIVER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
AT_USERNAME=
AT_API_KEY=
AT_FROM=

# --- Queue: "bullmq" (redis, requires worker process) | "inline" (in-process; dev/test) ---
QUEUE_DRIVER=bullmq

# --- App / email links ---
APP_PUBLIC_URL=http://localhost:5173
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MIN=30

# --- Observability ---
# Optional log level override: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=
# Optional Sentry error tracking. Set DSN and run: npm i @sentry/node
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Database backups (used by scripts/backup-db.sh) ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# Optional offsite upload (requires the aws CLI on the host):
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=

# --- Bootstrap (used once by npm run db:seed) ---
BOOTSTRAP_SCHOOL_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
