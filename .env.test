NODE_ENV=test
PORT=4100
API_PREFIX=/api/v1
DATABASE_URL="postgresql://sms:sms_password@127.0.0.1:5432/sms_test?schema=public"
REDIS_URL="redis://127.0.0.1:6379"
JWT_ACCESS_SECRET="test-access-secret-please-change-this-32chars-min-0"
JWT_REFRESH_SECRET="test-refresh-secret-please-change-this-32chars-min0"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=8
CORS_ORIGINS="http://localhost:5173"
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MIN=15
GLOBAL_RATE_LIMIT_MAX=100000
GLOBAL_RATE_LIMIT_WINDOW_MIN=15
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-local-test
STORAGE_PUBLIC_BASE_URL=http://localhost:4100/files
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_MIME="image/jpeg,image/png,image/webp,application/pdf"
EMAIL_DRIVER=console
EMAIL_FROM="SMS <no-reply@sms.local>"
SMS_DRIVER=console
QUEUE_DRIVER=inline
APP_PUBLIC_URL=http://localhost:5173
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MIN=30
